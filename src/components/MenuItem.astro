---
interface Props {
  name: string;
  price: string;
  description?: string;
}
const { name, price, description } = Astro.props;
---

<div class="menu-item">
  <div class="menu-item__header">
    <span class="menu-item__name">{name}</span>
    <span class="menu-item__dots"></span>
    <span class="menu-item__price">{price}</span>
  </div>
  {description && <p class="menu-item__desc">{description}</p>}
</div>
