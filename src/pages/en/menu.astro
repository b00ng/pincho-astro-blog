---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
---

<BaseLayout lang="en" title="A La Carte Menu | Pincho Tapas Kitchen" description="Explore the full A La Carte menu at Pincho Tapas Kitchen — featuring fresh seafood tapas, Wagyu beef, Iberico pork, Raclette cheese, and handcrafted desserts.">
  <link rel="stylesheet" href="/assets/style.css" />

  <!-- Menu Mode Switcher -->
  <div class="menu-mode-bar">
    <div class="menu-mode-tabs">
      <a href="/en/menu/" class="mode-tab active">
        <i class="fas fa-utensils"></i> A La Carte Menu
      </a>
      <a href="/en/menu/brunch/" class="mode-tab">
        <i class="fas fa-sun"></i> Set / Brunch Menu
      </a>
    </div>
  </div>

  <!-- Main Static Menu Content -->
  <div class="menu-wrapper">
    <header class="masthead" id="top">
      <div class="rule" aria-hidden="true"><span></span></div>
      <div class="masthead-grid">
        <div class="hours">
          <p>Open<br/>hour</p>
          <span>11.00 — 14.00</span>
          <span>17.30 — 22.30</span>
        </div>
        <img class="logo" src="/assets/images/logo.jpg" alt="Pincho Tapas Kitchen & Drinks"/>
        <div class="share">
          <span aria-hidden="true">◉</span>
          <p>Love to<br/>snap &amp;<br/>share!</p>
        </div>
      </div>
      <div class="rule" aria-hidden="true"><span></span></div>
    </header>

    <nav class="menu-nav" aria-label="Menu sections">
      <a href="#sea">Sea</a>
      <a href="#ground">Ground</a>
      <a href="#cold-cut">Cold cut</a>
      <a href="#salad">Salad</a>
      <a href="#seasonal">Seasonal</a>
      <a href="#hot">Hot dish</a>
      <a href="#raclette">Raclette</a>
      <a href="#dessert">Dessert</a>
    </nav>

    <!-- Tapas from the sea -->
    <section class="menu-section split split--left" id="sea">
      <img class="photo-rail photo-rail--tall" src="/assets/images/sea.jpg" alt="Pincho seafood tapas selection"/>
      <div class="section-body">
        <h2>Tapas from the sea</h2>
        <div class="dish-list">
          <article class="dish">
            <div class="dish-copy">
              <h3><span>S1.</span> Smoked salmon, spicy crab salad, avocado &amp; Vietnamese "bánh đa" (2pcs)</h3>
              <p lang="vi">Cá hồi xông khói, quả bơ, cua nghiền cay và bánh đa Việt Nam</p>
            </div>
            <strong class="price">90</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>S2.</span> Scallop sesame tart, chili oil, taro foam (2pcs) <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Tart vừng sò điệp, dầu ớt và bọt khoai môn</p>
            </div>
            <strong class="price">120</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>S3.</span> Scallop, wasabi mousse &amp; ponzu sauce (2pcs)</h3>
              <p lang="vi">Sò điệp, mousse mù tạt và xốt Ponzu</p>
            </div>
            <strong class="price">130</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>S4.</span> Prawn ‘bánh đa’ tacos, avocado &amp; creamy Tom Yum (2pcs)</h3>
              <p lang="vi">Tacos tôm bánh đa, quả bơ và xốt kem Tom Yum</p>
            </div>
            <strong class="price">90</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>S5.</span> Unagi, truffle oil, foie gras ballotine &amp; Vietnamese "bánh đa" (2pcs) <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Lươn nướng, dầu nấm truffle, gan ngỗng muối và bánh đa</p>
            </div>
            <strong class="price">140</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>S6.</span> Raw shrimp in rice cracker (2pcs)</h3>
              <p lang="vi">Tôm sống cuốn trong bánh tráng giòn</p>
            </div>
            <strong class="price">130</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>S7.</span> Octopus, chorizo, potatoes &amp; hollandaise <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Bạch tuộc nướng, xúc xích cay, khoai tây và xốt Hollandaise</p>
            </div>
            <strong class="price">210</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>S8.</span> Grilled shrimp, potato, hollandaise &amp; kataifi</h3>
              <p lang="vi">Tôm nướng, khoai tây, xốt Hollandaise và sợi kataifi</p>
            </div>
            <strong class="price">190</strong>
          </article>
        </div>
        <blockquote>“We recommend sharing 3 tapas dishes as a starter<br/>or 6 as a main course between two people”</blockquote>
      </div>
    </section>

    <div class="rule" aria-hidden="true"><span></span></div>

    <!-- Tapas from the ground -->
    <section class="menu-section split split--right" id="ground">
      <div class="section-body">
        <h2>Tapas from the ground</h2>
        <div class="dish-list">
          <article class="dish">
            <div class="dish-copy">
              <h3><span>G1.</span> Coppa ham, brie, cranberries &amp; ciabatta (2pcs)</h3>
              <p lang="vi">Thịt cổ lợn muối, quả nam việt quất và phô mai Brie, bánh mì ciabatta</p>
            </div>
            <strong class="price">80</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>G2.</span> Paleta Iberico, avocado, cream cheese &amp; ciabatta (2pcs)</h3>
              <p lang="vi">Thịt đùi trước Iberico, quả bơ, kem phô mai và bánh mì ciabatta</p>
            </div>
            <strong class="price">150</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>G3.</span> Iberico tacos, baby corns &amp; corn purée (2pcs)</h3>
              <p lang="vi">Tacos thịt lợn chân đen Tây Ban Nha, ngô bao tử và ngô nghiền</p>
            </div>
            <strong class="price">140</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>G4.</span> Fillet of beef, dried tomato &amp; celeriac remoulade (2pcs)</h3>
              <p lang="vi">Bò áp chảo, cà chua sấy và kem cần tây</p>
            </div>
            <strong class="price">150</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>G5.</span> Wagyu beef, aioli sauce &amp; garlic cracker (3pcs) <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Bò Wagyu khô, xốt Aioli và bánh mì tỏi giòn</p>
            </div>
            <strong class="price">180</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>G6.</span> Pulled Iberico pork croquettes, quail egg, bell peppers &amp; hollandaise sauce</h3>
              <p lang="vi">Iberico xé sợi hầm, trứng cút, ớt Đà Lạt muối và xốt Hollandaise</p>
            </div>
            <strong class="price">100</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>G7.</span> Grilled mushroom, truffle oil, aioli, perilla leaf &amp; garlic cracker (2pcs) <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Nấm nướng, dầu nấm truffle, xốt Aioli, lá tía tô và bánh mì tỏi giòn</p>
            </div>
            <strong class="price">70</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>G8.</span> Foie gras with roasted apple, grilled pineapple, mango salsa &amp; brioche <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Gan ngỗng áp chảo với táo nướng, dứa nướng, xoài tươi trộn và bánh mì ngọt</p>
            </div>
            <strong class="price">290</strong>
          </article>
        </div>
      </div>
      <img class="photo-rail photo-rail--tall" src="/assets/images/ground.jpg" alt="Pincho meat and vegetable tapas selection"/>
    </section>

    <div class="rule" aria-hidden="true"><span></span></div>

    <!-- Cold cut -->
    <section class="menu-section cold-cut" id="cold-cut">
      <div class="vertical-title"><span>Cold</span><span>~Cut</span></div>
      <img class="wide-photo" src="/assets/images/cold-cut.jpg" alt="Cold cut platters"/>
      <div class="dish-list">
        <article class="dish">
          <div class="dish-copy">
            <h3><span>C1.</span> Veggie cold cut</h3>
            <p lang="vi">Khay khai vị chay gồm: phô mai Feta, bánh mì tỏi giòn, ớt chuông, dưa chuột, quả và khô, cà chua oliu, xốt ớt chuông nghiền, cream cheese tỏi</p>
          </div>
          <strong class="price">190</strong>
        </article>
        <article class="dish">
          <div class="dish-copy">
            <h3><span>C2.</span> Jamón Iberico puro bellota cold cut</h3>
            <p lang="vi">Thịt đùi lợn chân đen Jamón Iberico Bellota muối</p>
          </div>
          <strong class="price">780 / 50gr</strong>
        </article>
        <article class="dish">
          <div class="dish-copy">
            <h3><span>C3.</span> Selection of Iberian charcuterie (chorizo / salami / paleta)</h3>
            <p lang="vi">Đĩa các loại thịt nguội từ lợn Iberico</p>
          </div>
          <strong class="price">460</strong>
        </article>
      </div>
    </section>

    <div class="rule" aria-hidden="true"><span></span></div>

    <!-- Salad Veggie -->
    <section class="menu-section salad" id="salad">
      <div class="vertical-title vertical-title--salad"><span>Salad</span><span>Veggie</span></div>
      <div class="section-body">
        <div class="dish-list">
          <article class="dish">
            <div class="dish-copy">
              <h3><span>V1.</span> Pincho salad — smoked salmon, shrimp, avocado &amp; kumquat sauce <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Salad cá hồi xông khói, tôm, quả bơ và xốt quất</p>
            </div>
            <strong class="price">190</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>V2.</span> Garden salad — Parma ham, seasonal fruit, dried bell pepper, mozzarella</h3>
              <p lang="vi">Salad thịt đùi lợn muối, cam, bưởi, ớt sấy, phô mai mozzarella</p>
            </div>
            <strong class="price">220</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>V3.</span> Chicken salad, pumpkin, asparagus, avocado &amp; honey mustard</h3>
              <p lang="vi">Salad lườn gà, bí đỏ, măng tây, quả bơ, xốt mù tạt mật ong</p>
            </div>
            <strong class="price">150</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>V4.</span> “Fruit Ninja” salad — seasonal fruit, Parma ham, Feta cheese &amp; candied peanut <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Salad hoa quả theo mùa, thịt đùi lợn muối, phô mai Feta, đậu phộng ngào đường</p>
            </div>
            <strong class="price">220</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>V5.</span> Duxelle of mushroom, hollandaise &amp; poached quail egg</h3>
              <p lang="vi">Nấm đốt rượu Madeira ăn cùng trứng cút chần và xốt Hollandaise</p>
            </div>
            <strong class="price">90</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>V6.</span> “Lady Burrata” — burrata, seasonal fruits, poached pear, rice wine, honey &amp; candied peanut <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Phô mai Burrata, hoa quả theo mùa, lê hầm, rượu nếp, mật ong và đậu phộng ngào đường</p>
            </div>
            <strong class="price">320</strong>
          </article>
        </div>
      </div>
      <div class="photo-with-note">
        <p>Extra truffle burrata +220K <i>|</i> Natural burrata +160K</p>
        <img src="/assets/images/salad.jpg" alt="Pincho salads and burrata"/>
      </div>
    </section>

    <div class="rule" aria-hidden="true"><span></span></div>

    <!-- Seasonal taste -->
    <section class="menu-section seasonal" id="seasonal">
      <img class="seasonal-photo" src="/assets/images/seasonal.jpg" alt="Seasonal Pincho dishes"/>
      <div class="seasonal-copy">
        <h2>Seasonal taste</h2>
        <div class="orange-panel">
          <div class="dish-list dish-list--inverted">
            <article class="dish">
              <div class="dish-copy">
                <h3><span>ST1.</span> Wagyu beef tartare, flying fish roe, toast (2pcs)</h3>
                <p lang="vi">Bò Wagyu sống trộn 3 loại xốt, trứng cá chuồn, bánh mì bơ áp chảo</p>
              </div>
              <strong class="price">180</strong>
            </article>
            <article class="dish">
              <div class="dish-copy">
                <h3><span>ST2.</span> Japanese rice in shrimp bisque sauce, raw shrimp &amp; chili oil <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
                <p lang="vi">Cơm Nhật nấu trong xốt đầu tôm, tôm sống và dầu ớt</p>
              </div>
              <strong class="price">110</strong>
            </article>
            <article class="dish">
              <div class="dish-copy">
                <h3><span>ST3.</span> Duck breast, foie gras, yellow radish, potato espuma (2pcs)</h3>
                <p lang="vi">Lườn vịt, gan ngỗng, củ cải vàng muối, bọt khoai tây</p>
              </div>
              <strong class="price">140</strong>
            </article>
            <article class="dish">
              <div class="dish-copy">
                <h3><span>ST4.</span> Seafood mushroom — pasta, scallop, shrimp, bell pepper &amp; Tom Yum <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
                <p lang="vi">Sợi mì nấm, sò điệp Nhật, tôm, ớt chuông sấy và xốt Tom Yum</p>
              </div>
              <strong class="price">220</strong>
            </article>
            <article class="dish">
              <div class="dish-copy">
                <h3><span>ST5.</span> Burrata, green grape, Parma ham &amp; almond <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
                <p lang="vi">Burrata, nho xanh, thịt ba chỉ muối, hạnh nhân và dầu oliu</p>
              </div>
              <strong class="price">250</strong>
            </article>
            <article class="dish">
              <div class="dish-copy">
                <h3><span>ST6.</span> Japanese oyster &amp; lemon sorbet / thyme oil &amp; herbal sorbet</h3>
                <p lang="vi">Hàu Nhật và xốt kem chanh vàng hoặc xốt kem dầu cỏ xạ hương và thảo mộc</p>
              </div>
              <strong class="price">120 / pc</strong>
            </article>
          </div>
        </div>
      </div>
    </section>

    <div class="rule" aria-hidden="true"><span></span></div>

    <!-- Hot dish -->
    <section class="menu-section hot" id="hot">
      <div class="vertical-title vertical-title--hot"><span>Hot dish</span></div>
      <div class="section-body">
        <div class="dish-list">
          <article class="dish">
            <div class="dish-copy">
              <h3><span>H1.</span> Iberico (140gr), purple cabbage, sweet potato, olive <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Thịt lợn chân đen Iberico Tây Ban Nha, bắp cải tím, khoai lang tím chiên, oliu</p>
            </div>
            <strong class="price">480</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>H2.</span> Grilled lamb rack, cauliflower, caramelized peanuts &amp; yellow bell pepper purée</h3>
              <p lang="vi">Dẻ sườn cừu nướng, bông cải trắng, đậu phộng ngào đường và ớt chuông vàng nghiền</p>
            </div>
            <strong class="price">480</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>H3.</span> Wagyu flank (140gr), wedge potatoes, grilled king mushroom, truffle aioli &amp; black garlic purée <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Thịt bò Wagyu, khoai chiên ba lửa, nấm đùi gà, xốt tỏi truffle và tỏi đen nghiền</p>
            </div>
            <strong class="price">520</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>H4.</span> Seared Wagyu beef, Japanese rice, garlic scapes &amp; quail eggs</h3>
              <p lang="vi">Thịt bò Wagyu thái lát khô, cơm Nhật, ngồng tỏi và trứng cút</p>
            </div>
            <strong class="price">380</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>H5.</span> Pincho’s truffle pasta with Paleta Iberico ham &amp; 2 kinds of cured pork</h3>
              <p lang="vi">Mỳ Ý kem nấm Truffle, thịt đùi trước Iberico và 2 loại thịt muối</p>
            </div>
            <strong class="price">250</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>H6.</span> Small meat platter (160gr Iberico pork &amp; 250gr flap meat Angus)</h3>
              <p lang="vi">Khay thịt cỡ nhỏ: thịt lợn chân đen Tây Ban Nha và diềm bụng bò Angus</p>
            </div>
            <strong class="price">880</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>H7.</span> Big meat platter (160gr Iberico pork, 250gr flap meat Angus &amp; lamb chops)</h3>
              <p lang="vi">Khay thịt cỡ lớn: thịt lợn chân đen Tây Ban Nha, diềm bụng bò Angus và dẻ sườn cừu</p>
            </div>
            <strong class="price">1,480</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>H8.</span> Special meat plate &amp; raclette (160gr Iberico, 140gr Wagyu flank MBS 7/8 &amp; raclette cheese) <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Khay thịt đặc biệt ăn cùng phô mai Raclette</p>
            </div>
            <strong class="price">1,380</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>H9.</span> Dry aged Angus striploin (portion from 300gr), three-times-fried wedge potatoes, bell pepper, grilled mushrooms, pepper sauce &amp; aioli pesto <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Thăn ngoại bò Angus ủ khô phần cắt từ 300g, khoai tây chiên 3 lửa, xốt tiêu, xốt húng tây</p>
            </div>
            <strong class="price">380 / 100gr</strong>
          </article>
        </div>
      </div>
      <img class="hot-photo" src="/assets/images/hot.jpg" alt="Hot dishes and meat platters"/>
    </section>

    <div class="rule" aria-hidden="true"><span></span></div>

    <!-- Raclette -->
    <section class="menu-section raclette" id="raclette">
      <img class="raclette-photo" src="/assets/images/raclette.jpg" alt="Raclette cheese dishes"/>
      <div class="raclette-copy">
        <div class="dish-list">
          <article class="dish">
            <div class="dish-copy">
              <h3><span>R1.</span> Raclette cheese &amp; cold cut for sharing <b class="stamp" aria-label="Pincho recommendation">★</b></h3>
              <p lang="vi">Khay Raclette với khoai tây xóc bơ tỏi, thịt nguội</p>
            </div>
            <strong class="price">420</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>R2.</span> Flap meat Angus (140gr), raclette cheese &amp; wedge potatoes</h3>
              <p lang="vi">Thịt bò Angus nướng, phô mai Raclette và khoai tây chiên 3 lửa</p>
            </div>
            <strong class="price">480</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>R3.</span> Three-times-fried wedge potatoes, raclette cheese &amp; crumbled bacon</h3>
              <p lang="vi">Khoai tây chiên ba lửa xóc bơ tỏi, phô mai Raclette và thịt ba chỉ chiên giòn</p>
            </div>
            <strong class="price">250</strong>
          </article>
          <article class="dish">
            <div class="dish-copy">
              <h3><span>R4.</span> Mashed potato stick, guanciale, honey &amp; goat cheese</h3>
              <p lang="vi">Khoai tây chiên que, thịt má heo muối kiểu Ý, mật ong và phô mai dê</p>
            </div>
            <strong class="price">180</strong>
          </article>
        </div>
        <h2>The cheesier<br/>the better</h2>
      </div>
    </section>

    <div class="rule" aria-hidden="true"><span></span></div>

    <!-- Dessert -->
    <section class="menu-section dessert" id="dessert">
      <h2>Dessert</h2>
      <div class="dish-list">
        <article class="dish">
          <div class="dish-copy">
            <h3><span>D1.</span> Basque burnt cheesecake truffle</h3>
            <p lang="vi">Bánh phô mai cháy nấm Truffle</p>
