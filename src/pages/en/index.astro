---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import MenuItem from '../../components/MenuItem.astro';
import BlogCard from '../../components/BlogCard.astro';
import ReservationForm from '../../components/ReservationForm.astro';

import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 6);

const featuredMenu = [
  {
    name: 'Octopus, Chorizo & Potatoes',
    price: '210,000₫',
    description: 'Grilled octopus, Spanish chorizo, tender potatoes & creamy hollandaise sauce',
    isStar: true,
  },
  {
    name: 'Scallop Sesame Tart',
    price: '120,000₫',
    description: 'Scallop sesame tart, chili oil & delicate taro foam (2pcs)',
    isStar: true,
  },
  {
    name: 'Wagyu Beef & Garlic Cracker',
    price: '180,000₫',
    description: 'Dried Wagyu beef, rich aioli sauce & crispy garlic cracker (3pcs)',
    isStar: true,
  },
  {
    name: 'Foie Gras with Roasted Apple',
    price: '290,000₫',
    description: 'Pan-seared foie gras with roasted apple, grilled pineapple, mango salsa & brioche',
    isStar: true,
  },
  {
    name: 'Pincho Salad',
    price: '190,000₫',
    description: 'Smoked salmon, succulent shrimp, fresh avocado & zesty kumquat dressing',
    isStar: true,
  },
  {
    name: '“Lady Burrata” Salad',
    price: '320,000₫',
    description: 'Fresh Burrata, seasonal fruits, poached pear, rice wine, honey & candied peanut',
    isStar: true,
  },
  {
    name: 'Iberico Pork (140g)',
    price: '480,000₫',
    description: 'Spanish Iberico black pig, braised purple cabbage, purple sweet potato & olives',
    isStar: true,
  },
  {
    name: 'Raclette Cheese & Cold Cut',
    price: '420,000₫',
    description: 'Melted Raclette cheese served over artisan cured meats & garlic butter potatoes',
    isStar: true,
  },
];
---

<BaseLayout lang="en" title="Pincho — Tapas Kitchen & Drinks | Spanish Restaurant Hanoi">
  <!-- Hero Section -->
  <section class="hero" style="background-image: url('/images/posts/1185517790436446.jpg')">
    <div class="hero__content">
      <h1 class="hero__title animate animate--up">
        Tapas Kitchen <span>& Drinks</span>
      </h1>
      <p class="hero__subtitle animate animate--up">
        Award-winning Spanish-fusion tapas, creative cocktails, and panoramic city views from the upper floors of our historic villa in Hà Nội.
      </p>
      <div class="animate animate--up" style="margin: 1.5rem 0 2rem; display: flex; justify-content: center; gap: 1rem; align-items: center;">
        <span style="background: rgba(230, 81, 0, 0.9); padding: 8px 16px; border-radius: 50px; font-size: 0.75rem; font-weight: 700; color: #fff; letter-spacing: 0.05em; text-transform: uppercase; border: 1px solid rgba(255,255,255,0.2);">
          <i class="fas fa-crown"></i> 2022 Restaurant of the Year
        </span>
      </div>
      <div class="animate animate--up" style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/en/book-a-table/" class="btn btn--primary" style="padding: 14px 36px; border-radius: 50px;">
          <i class="far fa-calendar-alt" style="margin-right: 8px;"></i> Book A Table Now
        </a>
        <a href="/en/menu/" class="hero__cta">Explore Our Menu</a>
      </div>
    </div>
  </section>

  <!-- About Preview -->
  <section class="section section--alt">
    <div class="container about-preview">
      <SectionHeader title="Welcome to" accent="Pincho" />
      <p class="about-preview__text animate animate--up">
        Nestled in the upper floors of a charming French colonial villa at 34C Cao Ba Quat, Pincho offers an award-winning tapas experience. Our warm lighting and captivating decor set the perfect stage for romantic dates or shared gatherings, presenting a creative fusion of bold Spanish flavors, premium ingredients, curated wines, and Vietnamese culinary artistry.
      </p>
      <a href="/en/about/" class="btn btn--outline btn--center animate animate--up">Read Our Story →</a>
    </div>
  </section>

  <!-- Featured Menu -->
  <section class="section">
    <div class="container">
      <SectionHeader
        title="Featured"
        accent="Menu"
        subtitle="Discover our chef-recommended star dishes (★) from Pincho's A La Carte menu"
      />
      <div class="menu-grid animate animate--up">
        {featuredMenu.map(item => (
          <MenuItem name={item.name} price={item.price} description={item.description} isStar={item.isStar} />
        ))}
      </div>
      <a href="/en/menu/" class="btn btn--primary btn--center">View Full Menu</a>
    </div>
  </section>

  <!-- Reservation Section on Homepage -->
  <section class="section section--alt" id="reservation-section">
    <div class="container">
      <SectionHeader
        title="Reserve"
        accent="Online"
        subtitle="Book ahead to guarantee the finest seating experience at Pincho"
      />
      <div style="max-width: 800px; margin: 0 auto;" class="animate animate--up">
        <ReservationForm lang="en" googleFormId="e/1FAIpQLSetdH6CAmUu1UjvhfWAACyTnxU15-4CKu7y4jrTnbdVj93I7w" />
      </div>
    </div>
  </section>

  <!-- Blog Checkerboard -->
  <section class="section">
    <div class="container">
      <SectionHeader title="Our" accent="Stories" subtitle="Latest stories from Pincho's kitchen and space" />
    </div>
    <div class="blog-checkerboard">
      {posts.map(post => (
        <BlogCard
          title={post.data.title}
          date={post.data.date}
          excerpt={post.data.description}
          image={post.data.images?.[0]}
          href={`/en/posts/${post.id}/`}
        />
      ))}
    </div>
    <a href="/en/posts/" class="btn btn--primary btn--center" style="margin-top: 2rem;">View All Stories</a>
  </section>

  <!-- Contact Strip -->
  <section class="section" style="padding: 0;">
    <div class="container">
      <div class="contact-strip">
        <div class="contact-strip__item">
          <div class="contact-strip__label">Address</div>
          <div class="contact-strip__value">34C Cao Ba Quat, Ba Dinh, Hanoi</div>
        </div>
        <div class="contact-strip__item">
          <div class="contact-strip__label">Reservations</div>
          <div class="contact-strip__value"><a href="tel:0949022882">0949.022.882</a></div>
        </div>
        <div class="contact-strip__item">
          <div class="contact-strip__label">Hours</div>
          <div class="contact-strip__value">Mon – Sun: 11:00 – 23:00</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
