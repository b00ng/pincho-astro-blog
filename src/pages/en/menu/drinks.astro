---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import drinksData from '../../../data/drinks.json';

const { wine_by_glass, wine_by_bottle, sangria_cocktails, mocktails_juices, beers_others } = drinksData;
---

<BaseLayout
  lang="en"
  title="Drink Menu | Pincho Tapas Kitchen & Drinks"
  description="Explore the curated Drink Menu at Pincho Tapas Kitchen — Sommelier-selected international wines, Signature Cocktails, Sangria, Craft Beers, Mocktails & Junbucha."
>
  <link rel="stylesheet" href="/assets/style.css" />

  <!-- Menu Mode Switcher -->
  <div class="menu-mode-bar">
    <div class="menu-mode-tabs">
      <a href="/en/menu/" class="mode-tab">
        <i class="fas fa-utensils"></i> A La Carte
      </a>
      <a href="/en/menu/brunch/" class="mode-tab">
        <i class="fas fa-sun"></i> Set / Brunch
      </a>
      <a href="/en/menu/drinks/" class="mode-tab active">
        <i class="fas fa-wine-glass-alt"></i> Drinks
      </a>
    </div>
  </div>

  <div class="menu-wrapper drinks-page">
    <!-- Drinks Hero -->
    <header class="drinks-hero">
      <div class="drinks-hero__badge">
        <i class="fas fa-glass-cheers"></i> PINCHO DRINK LIST 2026
      </div>
      <h1 class="drinks-hero__quote">
        “First you take a drink,<br/>then the drink takes a drink,<br/><span>then the drink takes you”</span>
      </h1>
      <p class="drinks-hero__subtitle">
        Explore our curated selection of sommelier-recommended international wines, artisan cocktails, handcrafted beers, and refreshing non-alcoholic creations.
      </p>
    </header>

    <!-- In-page Navigation -->
    <nav class="drinks-nav" aria-label="Drink menu sections">
      <a href="#wine-by-glass">Wine by Glass</a>
      <a href="#sparkling-rose">Sparkling &amp; Rose</a>
      <a href="#white-wine">White Wine</a>
      <a href="#red-wine">Red Wine</a>
      <a href="#cocktails">Cocktails &amp; Sangria</a>
      <a href="#mocktails-juices">Mocktails &amp; Juices</a>
      <a href="#beers-others">Beers &amp; Others</a>
    </nav>

    <!-- 1. Wine by Glass -->
    <section class="drink-section" id="wine-by-glass">
      <div class="section-title-wrap">
        <div class="section-tag">BY THE GLASS</div>
        <h2 class="drink-heading">Wine By Glass</h2>
        <p class="section-subdesc">Delight in refined wine pours by the glass or by the bottle</p>
      </div>

      <div class="wine-glass-grid">
        {wine_by_glass.sections.map((sec) => (
          <div class="wine-glass-card">
            <h3 class="wine-subheading">
              <span class="subheading-accent">♦</span> {sec.title}
            </h3>
            <div class="wine-list">
              {sec.items.map((item) => (
                <div class="wine-row">
                  <div class="wine-info">
                    <strong class="wine-name">{item.name}</strong>
                    <span class="wine-grape">{item.grape}</span>
                  </div>
                  <div class="wine-prices">
                    <div class="price-pill">
                      <span class="price-icon" title="By glass">🍷</span>
                      <span class="price-val">{item.glass}</span>
                    </div>
                    <div class="price-pill price-pill--bottle">
                      <span class="price-icon" title="By bottle">🍾</span>
                      <span class="price-val">{item.bottle}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="section-tax-note">* All prices exclude taxes and fees</p>
    </section>

    <div class="drinks-divider" aria-hidden="true"><span></span></div>

    <!-- 2. Champagne, Sparkling & Rose -->
    <section class="drink-section" id="sparkling-rose">
      <div class="section-title-wrap">
        <div class="section-tag">BY THE BOTTLE</div>
        <h2 class="drink-heading">Champagne, Sparkling &amp; Rose</h2>
        <p class="section-subdesc">Prestige Champagnes, celebratory sparklings, and elegant rosés</p>
      </div>

      <div class="wine-bottle-grid">
        {wine_by_bottle.sections.slice(0, 2).map((sec) => (
          <div class="wine-card">
            <h3 class="wine-subheading">
              <span class="subheading-accent">♦</span> {sec.category}
            </h3>
            <div class="wine-list">
              {sec.items.map((item) => (
                <div class="wine-row">
                  <div class="wine-info">
                    <strong class="wine-name">
                      {item.name}
                      {item.sommelier && (
                        <span class="sommelier-badge" title="Sommelier Recommended">
                          <i class="fas fa-wine-glass"></i> Sommelier Pick
                        </span>
                      )}
                    </strong>
                    <span class="wine-grape">{item.grape}</span>
                  </div>
                  <div class="wine-prices">
                    <div class="price-pill price-pill--bottle">
                      <span class="price-icon">🍾</span>
                      <span class="price-val">{item.bottle}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="drinks-divider" aria-hidden="true"><span></span></div>

    <!-- 3. White Wine (Bottle) -->
    <section class="drink-section" id="white-wine">
      <div class="section-title-wrap">
        <div class="section-tag">WHITE WINE BY THE BOTTLE</div>
        <h2 class="drink-heading">White Wine</h2>
        <p class="section-subdesc">Curated white wines from France, New Zealand, Spain, Chile, Argentina &amp; Germany</p>
      </div>

      <div class="wine-bottle-grid">
        {wine_by_bottle.sections.slice(2, 4).map((sec) => (
          <div class="wine-card">
            <h3 class="wine-subheading">
              <span class="subheading-accent">♦</span> {sec.category}
            </h3>
            <div class="wine-list">
              {sec.items.map((item) => (
                <div class="wine-row">
                  <div class="wine-info">
                    <strong class="wine-name">
                      {item.name}
                      {item.sommelier && (
                        <span class="sommelier-badge" title="Sommelier Recommended">
                          <i class="fas fa-wine-glass"></i> Sommelier Pick
                        </span>
                      )}
                    </strong>
                    <span class="wine-grape">{item.grape}</span>
                  </div>
                  <div class="wine-prices">
                    <div class="price-pill price-pill--bottle">
                      <span class="price-icon">🍾</span>
                      <span class="price-val">{item.bottle}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="drinks-divider" aria-hidden="true"><span></span></div>

    <!-- 4. Red Wine (Bottle) -->
    <section class="drink-section" id="red-wine">
      <div class="section-title-wrap">
        <div class="section-tag">RED WINE BY THE BOTTLE</div>
        <h2 class="drink-heading">Red Wine</h2>
        <p class="section-subdesc">From supple, fruit-forward pours to rich, structured, world-renowned vintages</p>
      </div>

      <div class="wine-bottle-grid">
        {wine_by_bottle.sections.slice(4).map((sec) => (
          <div class="wine-card">
            <h3 class="wine-subheading">
              <span class="subheading-accent">♦</span> {sec.category}
            </h3>
            <div class="wine-list">
              {sec.items.map((item) => (
                <div class="wine-row">
                  <div class="wine-info">
                    <strong class="wine-name">
                      {item.name}
                      {item.sommelier && (
                        <span class="sommelier-badge" title="Sommelier Recommended">
                          <i class="fas fa-wine-glass"></i> Sommelier Pick
                        </span>
                      )}
                    </strong>
                    <span class="wine-grape">{item.grape}</span>
                  </div>
                  <div class="wine-prices">
                    <div class="price-pill price-pill--bottle">
                      <span class="price-icon">🍾</span>
                      <span class="price-val">{item.bottle}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="drinks-divider" aria-hidden="true"><span></span></div>

    <!-- 5. Sangria & Cocktails -->
    <section class="drink-section" id="cocktails">
      <div class="section-title-wrap">
        <div class="section-tag">MIXOLOGY</div>
        <h2 class="drink-heading">Cocktails &amp; Sangria</h2>
        <p class="section-subdesc">Signature concoctions and enduring classics inspired by Spanish vibrancy</p>
      </div>

      <!-- Sangria Spotlight -->
      <div class="sangria-banner">
        <div class="sangria-banner__header">
          <span class="sangria-icon">🍷</span>
          <h3>Save Water, Drink Sangria</h3>
          <p>The iconic Spanish favorite — brimming with seasonal fresh fruits and aromatic herbs</p>
        </div>
        <div class="sangria-grid">
          {sangria_cocktails.sangria.items.map((item) => (
            <div class="sangria-card">
              <div class="sangria-card__top">
                <h4>{item.name}</h4>
                <div class="sangria-prices">
                  <span class="price-tag"><small>Glass</small> {item.price_small}</span>
                  <span class="price-sep">/</span>
                  <span class="price-tag"><small>Pitcher</small> {item.price_big}</span>
                </div>
              </div>
              <p class="sangria-card__desc">{item.ingredients}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Signature Cocktail Spotlight -->
      <div class="signature-spotlight">
        <div class="signature-badge">
          <i class="fas fa-award"></i> {sangria_cocktails.signature.items[0].badge}
        </div>
        <div class="signature-content">
          <div class="signature-text">
            <h3>{sangria_cocktails.signature.items[0].name}</h3>
            <p class="signature-desc">{sangria_cocktails.signature.items[0].ingredients}</p>
          </div>
          <div class="signature-price">
            <strong>{sangria_cocktails.signature.items[0].price}</strong>
          </div>
        </div>
      </div>

      <!-- Classic Cocktails -->
      <div class="cocktails-block">
        <h3 class="wine-subheading">
          <span class="subheading-accent">♦</span> Classic Cocktails
        </h3>
        <div class="cocktails-grid">
          {sangria_cocktails.classics.items.map((item) => (
            <div class="cocktail-item">
              <div class="cocktail-header">
                <span class="cocktail-name">{item.name}</span>
                <span class="menu-item__dots"></span>
                <span class="cocktail-price">{item.price}</span>
              </div>
              <p class="cocktail-desc">{item.ingredients}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="drinks-divider" aria-hidden="true"><span></span></div>

    <!-- 6. Mocktails, Fresh Juices & Junbucha -->
    <section class="drink-section" id="mocktails-juices">
      <div class="section-title-wrap">
        <div class="section-tag">NON-ALCOHOLIC &amp; REFRESHING</div>
        <h2 class="drink-heading">Mocktails, Fresh Fruit Juices &amp; Junbucha</h2>
        <p class="section-subdesc">Wholesome, zesty, and non-alcoholic drinks crafted for pure refreshment</p>
      </div>

      <div class="nonalc-grid">
        <!-- Mocktails -->
        <div class="nonalc-card">
          <h3 class="wine-subheading"><span class="subheading-accent">♦</span> Mocktails</h3>
          <div class="nonalc-list">
            {mocktails_juices.mocktails.map((item) => (
              <div class="nonalc-item">
                <div class="nonalc-header">
                  <strong>{item.name}</strong>
                  <span class="nonalc-price">{item.price}</span>
                </div>
                <p class="nonalc-desc">{item.ingredients}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Fresh Fruit Juices -->
        <div class="nonalc-card">
          <h3 class="wine-subheading"><span class="subheading-accent">♦</span> Fresh Fruit Juices</h3>
          <div class="nonalc-list">
            {mocktails_juices.fresh_juices.map((item) => (
              <div class="nonalc-item nonalc-item--simple">
                <div class="nonalc-header">
                  <strong>{item.name_en}</strong>
                  <span class="nonalc-price">{item.price}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Junbucha -->
        <div class="nonalc-card nonalc-card--junbucha">
          <h3 class="wine-subheading">
            <span class="subheading-accent">♦</span> Junbucha
            <small>(Naturally Fermented Honey Tea)</small>
          </h3>
          <div class="nonalc-list">
            {mocktails_juices.junbucha.map((item) => (
              <div class="nonalc-item">
                <div class="nonalc-header">
                  <strong>{item.name}</strong>
                  <span class="nonalc-price">{item.price}</span>
                </div>
                <p class="nonalc-desc">{item.ingredients}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="drinks-divider" aria-hidden="true"><span></span></div>

    <!-- 7. Beers, Soft Drinks, Tea & Coffee -->
    <section class="drink-section" id="beers-others">
      <div class="section-title-wrap">
        <div class="section-tag">BEERS &amp; BEVERAGES</div>
        <h2 class="drink-heading">Beers, Soft Drinks, Tea &amp; Coffee</h2>
        <p class="section-subdesc">Belgian &amp; local beers, premium mineral water, artisan teas &amp; Italian espresso</p>
      </div>

      <div class="others-grid">
        <!-- Beer -->
        <div class="others-card">
          <h3 class="wine-subheading"><span class="subheading-accent">🍺</span> Beers &amp; Craft Beers</h3>
          <div class="others-list">
            {beers_others.beers.map((item) => (
              <div class="others-item">
                <span class="others-name">{item.name}</span>
                <span class="menu-item__dots"></span>
                <span class="others-price">{item.price}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Soft Drinks & Water -->
        <div class="others-card">
          <h3 class="wine-subheading"><span class="subheading-accent">💧</span> Mineral Water &amp; Soft Drinks</h3>
          <div class="others-list">
            {beers_others.soft_drinks.map((item) => (
              <div class="others-item">
                <span class="others-name">{item.name}</span>
                <span class="menu-item__dots"></span>
                <span class="others-price">{item.price}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Tea -->
        <div class="others-card">
          <h3 class="wine-subheading"><span class="subheading-accent">🍵</span> Artisan Teas</h3>
          <div class="others-list">
            {beers_others.tea.map((item) => (
              <div class="others-item others-item--stacked">
                <div class="others-header-stacked">
                  <span class="others-name">{item.name}</span>
                  <span class="others-price">{item.price}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Coffee -->
        <div class="others-card">
          <h3 class="wine-subheading"><span class="subheading-accent">☕</span> Coffee</h3>
          <div class="others-list">
            {beers_others.coffee.map((item) => (
              <div class="others-item">
                <span class="others-name">{item.name}</span>
                <span class="menu-item__dots"></span>
                <span class="others-price">{item.price}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Menu Notes Footer -->
    <footer class="drinks-footer">
      <p>*** All prices are in VND and exclude VAT tax</p>
      <p>*** There is no service charge, so tips are welcome</p>
      <a href="#top" class="back-to-top">Back to top ↑</a>
    </footer>
  </div>

  <!-- PDF Download Section -->
  <section class="section section--alt" style="margin-top: 3rem;">
    <div class="container">
      <SectionHeader
        title="Original PDF Menu"
        subtitle="Download or view the complete original PDF design of Pincho Drink Menu 2026."
      />
      <div class="pdf-grid animate animate--up">
        <a
          href="/menu/Drink-Menu-2026.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="pdf-card pdf-card--highlight"
        >
          <div class="pdf-card__icon">
            <i class="fas fa-file-pdf" style="font-size: 48px;"></i>
          </div>
          <h3 class="pdf-card__title">Pincho Drink Menu 2026</h3>
          <span class="pdf-card__link">Download Original PDF</span>
        </a>

        <a
          href="/en/menu/"
          class="pdf-card"
        >
          <div class="pdf-card__icon">
            <i class="fas fa-utensils" style="font-size: 48px;"></i>
          </div>
          <h3 class="pdf-card__title">A La Carte Menu</h3>
          <span class="pdf-card__link">Explore A La Carte</span>
        </a>

        <a
          href="/en/menu/brunch/"
          class="pdf-card"
        >
          <div class="pdf-card__icon">
            <i class="fas fa-sun" style="font-size: 48px;"></i>
          </div>
          <h3 class="pdf-card__title">Pincho Set / Brunch</h3>
          <span class="pdf-card__link">Explore Set &amp; Brunch</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .menu-mode-bar {
    background: #e8dcc8;
    border-bottom: 2px solid var(--orange, #cf6e2a);
    padding: 0.8rem 0;
    margin-top: 72px;
  }
  .menu-mode-tabs {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  .mode-tab {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    background: #eee3cf;
    color: #151313;
    font-family: Arial Narrow, Arial, sans-serif;
    font-weight: 800;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.25s ease;
    border: 1px solid rgba(207, 110, 42, 0.3);
    white-space: nowrap;
  }
  .mode-tab:hover {
    background: #cf6e2a;
    color: #ffffff;
  }
  .mode-tab.active {
    background: #cf6e2a;
    color: #ffffff;
    border-color: #cf6e2a;
    box-shadow: 0 4px 12px rgba(207, 110, 42, 0.3);
  }
  @media (max-width: 680px) {
    .menu-mode-bar {
      padding: 0.6rem 0;
    }
    .menu-mode-tabs {
      gap: 0.4rem;
      padding: 0 0.5rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .menu-mode-tabs::-webkit-scrollbar {
      display: none;
    }
    .mode-tab {
      padding: 8px 10px;
      font-size: 0.78rem;
      letter-spacing: 0.04em;
    }
  }

  .drinks-page {
    background: #fbf8f2;
    width: min(1360px, 100%);
    margin: 0 auto;
    box-shadow: 0 0 55px rgba(50, 31, 12, 0.15);
  }

  /* Drinks Hero */
  .drinks-hero {
    background: linear-gradient(135deg, #1f140e 0%, #3e2213 50%, #1f140e 100%);
    color: #fff;
    padding: 70px 6% 60px;
    text-align: center;
    position: relative;
    border-bottom: 3px solid #cf6e2a;
  }
  .drinks-hero__badge {
    display: inline-block;
    background: #cf6e2a;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    padding: 6px 18px;
    border-radius: 50px;
    margin-bottom: 24px;
    text-transform: uppercase;
  }
  .drinks-hero__quote {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 4.5vw, 48px);
    line-height: 1.25;
    font-weight: 500;
    font-style: italic;
    color: #f7ca51;
    max-width: 900px;
    margin: 0 auto 20px;
  }
  .drinks-hero__quote span {
    color: #fff;
    font-style: normal;
    font-weight: 600;
    display: block;
    margin-top: 6px;
  }
  .drinks-hero__subtitle {
    color: #e5d3be;
    max-width: 720px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  /* Sticky Navigation */
  .drinks-nav {
    display: flex;
    justify-content: center;
    gap: 0.5rem 1rem;
    padding: 14px 20px;
    background: #eee3cf;
    border-bottom: 1px solid rgba(207, 110, 42, 0.25);
    position: sticky;
    top: 72px;
    z-index: 20;
    flex-wrap: wrap;
  }
  .drinks-nav a {
    color: #422612;
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 6px 12px;
    border-radius: 4px;
    transition: all 0.2s;
  }
  .drinks-nav a:hover {
    background: #cf6e2a;
    color: #fff;
  }

  /* Section Titles */
  .drink-section {
    padding: 50px clamp(20px, 4vw, 55px);
  }
  .section-title-wrap {
    text-align: center;
    margin-bottom: 35px;
  }
  .section-tag {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    color: #cf6e2a;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .drink-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 4vw, 46px);
    color: #2b1810;
    margin: 0 0 8px;
    letter-spacing: 0.02em;
  }
  .section-subdesc {
    color: #7d6b5c;
    font-size: 0.95rem;
    font-style: italic;
  }
  .drinks-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(207, 110, 42, 0.35), transparent);
    margin: 10px 5%;
  }

  /* Wine Grid & Cards */
  .wine-glass-grid,
  .wine-bottle-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 30px;
  }
  .wine-glass-card,
  .wine-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 26px 24px;
    border: 1px solid rgba(207, 110, 42, 0.18);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
  }
  .wine-subheading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.3rem;
    color: #cf6e2a;
    border-bottom: 1.5px solid #eee3cf;
    padding-bottom: 12px;
    margin: 0 0 16px;
  }
  .subheading-accent {
    color: #cf6e2a;
    font-size: 0.85rem;
    margin-right: 4px;
  }

  .wine-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
