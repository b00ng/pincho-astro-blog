---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout lang="vi" title="Bài Viết & Câu Chuyện | Pincho Tapas Kitchen">
  <PageHero title="Bài Viết & Câu Chuyện" />

  <section class="section">
    <div class="container" style="max-width: 1000px;">
      <div class="blog-checkerboard">
        {posts.map(post => (
          <BlogCard
            title={post.data.title}
            date={post.data.date}
            excerpt={post.data.description}
            image={post.data.images?.[0]}
            href={`/posts/${post.id}/`}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
