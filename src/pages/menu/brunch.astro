---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
---

<BaseLayout lang="vi" title="Thực Đơn Set & Brunch | Pincho Tapas Kitchen" description="Thực đơn Set Lunch & Brunch đặc sắc tại Pincho Tapas Kitchen — Business Lunch Set, Tapas Degustation Menu Pop, Couple Set Menu Two Much Fun.">
  <link rel="stylesheet" href="/assets/style.css" />

  <!-- Menu Mode Switcher -->
  <div class="menu-mode-bar">
    <div class="menu-mode-tabs">
      <a href="/menu/" class="mode-tab">
        <i class="fas fa-utensils"></i> A La Carte
      </a>
      <a href="/menu/brunch/" class="mode-tab active">
        <i class="fas fa-sun"></i> Set / Brunch
      </a>
      <a href="/menu/drinks/" class="mode-tab">
        <i class="fas fa-wine-glass-alt"></i> Đồ Uống
      </a>
    </div>
  </div>

  <!-- Main Brunch Menu Content -->
  <div class="menu-wrapper brunch-page">
    <section class="brunch-hero">
      <p>Pincho special set menu</p>
      <h1>Everything makes<br/>more sense<br/>in a set</h1>
      <span aria-hidden="true">⚓</span>
    </section>

    <section class="business-intro">
      <p class="eyebrow">Pincho Business Lunch Set Menu</p>
      <h2>Lunch tastes better<br/>when it comes together.</h2>
      <p>Only applies for groups under 6 persons · Chỉ áp dụng cho nhóm dưới 6 người</p>
    </section>

    <section class="set-grid">
      <!-- Light Set -->
      <article class="set-card set-card--orange">
        <header>
          <p>Light</p>
          <h2>Chill bites,<br/>zero regrets</h2>
          <strong>320K</strong>
        </header>
        <div class="set-items">
          <article>
            <h3>Lyonnaise salad, poached egg, pancetta &amp; balsamic</h3>
            <p lang="vi">Rau xanh, trứng chần, thịt lợn xông khói pancetta và xốt balsamic</p>
          </article>
          <article>
            <h3>Tapas plate — coppa ham / grilled mushroom tapas / smoked salmon</h3>
            <p lang="vi">Thịt cổ lợn muối / Nấm nướng / Cá hồi xông khói</p>
          </article>
        </div>
        <p class="choice">✦ Choose 1 of / Chọn 1 món</p>
        <div class="set-items">
          <article>
            <h3>Pincho’s truffle pasta with Paleta Iberico ham &amp; 2 kinds of cured pork</h3>
            <p lang="vi">Mỳ Ý kem nấm Truffle, thịt đùi trước Iberico và 2 loại thịt muối</p>
          </article>
          <article>
            <h3>Mushroom tartine, fried leeks &amp; cream cheese</h3>
            <p lang="vi">Bánh mỳ men chua, các loại nấm, tỏi tây chiên và kem phô mai</p>
          </article>
          <article>
            <h3>Chicken pesto, roasted tomato &amp; ciabatta</h3>
            <p lang="vi">Lườn gà xốt pesto, cà chua nướng và bánh mì ciabatta</p>
          </article>
        </div>
        <div class="dessert-note">
          <b>Lotus crème brûlée</b>
          <span>Kem nướng đường hạt sen</span>
        </div>
      </article>

      <!-- Bold Set -->
      <article class="set-card set-card--blue">
        <header>
          <p>Bold</p>
          <h2>Big flavour,<br/>no apologies</h2>
          <strong>420K</strong>
        </header>
        <p class="choice">✦ Choose 1 of / Chọn 1 món</p>
        <div class="set-items">
          <article>
            <h3>Chicken salad, pumpkin, asparagus, avocado &amp; honey mustard</h3>
            <p lang="vi">Salad lườn gà, bí đỏ, măng tây, quả bơ, xốt mù tạt mật ong</p>
          </article>
          <article>
            <h3>Fruit Ninja salad, seasonal fruit, Parma ham &amp; candied peanut</h3>
            <p lang="vi">Salad hoa quả theo mùa, thịt đùi lợn muối và đậu phộng ngào đường</p>
          </article>
        </div>
        <p class="choice">✦ Choose 1 of / Chọn 1 món</p>
        <div class="set-items">
          <article>
            <h3>Tapas plate — pulled Iberico pork croquettes / prawn ‘bánh đa’ tacos / grilled mushroom tapas</h3>
            <p lang="vi">Iberico xé sợi hầm / Tacos tôm bánh đa / Nấm nướng</p>
          </article>
          <article>
            <h3>Turkish egg, Paleta Iberico, chili oil, sourdough</h3>
            <p lang="vi">Trứng Thổ Nhĩ Kỳ, thịt lợn chân đen muối, dầu ớt, bánh mì men chua</p>
          </article>
        </div>
        <p class="choice">✦ Choose 1 of / Chọn 1 món</p>
        <div class="set-items">
          <article>
            <h3>Salmon tartine, cream cheese &amp; capers</h3>
            <p lang="vi">Bánh mỳ men chua, cá hồi xông khói, kem phô mai và nụ bạch hoa</p>
          </article>
          <article>
            <h3>Parma ham tartine, poached egg, dried tomato &amp; hollandaise</h3>
            <p lang="vi">Bánh mì men chua, thịt đùi heo muối, cà chua sấy và xốt Hollandaise</p>
          </article>
          <article>
            <h3>Spaghetti aglio e olio, shrimp &amp; fresh chorizo</h3>
            <p lang="vi">Mỳ Ý tỏi ớt, tôm và xúc xích Ý cay tươi</p>
          </article>
        </div>
        <div class="dessert-note">
          <b>Bread pudding, apricot spirit gelato</b>
          <span>Pudding bánh mì, kem rượu mơ</span>
        </div>
      </article>
    </section>

    <!-- Pop Degustation -->
    <section class="set-card pop-card">
      <header>
        <p>“Pop”</p>
        <h2>Pieces of pleasure,<br/>pieces of Pincho</h2>
        <strong>Tapas Degustation Menu · 580K</strong>
        <small>11 A.M — 2 P.M · Monday to Friday</small>
      </header>
      <div class="pop-story" lang="vi">
        9 loại tapas trong set như những mảnh nhỏ ghép nên màu sắc của bức vẽ Pincho. Có mảnh đã nhuốm màu thời gian, trở thành dấu ấn, có mảnh được tô điểm lại mỗi mùa, chính vì vậy mà Pincho luôn bí ẩn, vừa lạ, vừa quen.<br/><br/>
        Nhìn ngắm, đưa vào miệng một loại tapas bất kỳ, “POP”, bất ngờ sẽ tới với bạn.<br/>
        <b>Một hành trình gói gọn trong 9 lần chạm vị, đầy bí ẩn và bất ngờ.</b>
      </div>
      <div class="set-items">
        <article>
          <h3>Smoked salmon, spicy crab salad, avocado &amp; Vietnamese “bánh đa”</h3>
          <p lang="vi">Cá hồi xông khói, quả bơ, cua nghiền cay và bánh đa Việt Nam</p>
        </article>
        <article>
          <h3>Prawn “bánh đa” tacos, avocado &amp; creamy Tom Yum</h3>
          <p lang="vi">Tacos tôm bánh đa, quả bơ và xốt kem Tom Yum</p>
        </article>
        <article>
          <h3>Pulled Iberico pork croquettes, quail egg, bell peppers &amp; hollandaise sauce</h3>
          <p lang="vi">Iberico xé sợi hầm, trứng cút, ớt Đà Lạt muối và xốt Hollandaise</p>
        </article>
        <article>
          <h3>Shrimp croquettes, Parma ham, pickled shallot &amp; aioli sauce</h3>
          <p lang="vi">Viên tôm chiên, thịt đùi lợn muối, hành tím ngâm và xốt aioli</p>
        </article>
        <article>
          <h3>Coppa ham, Brie, cranberries &amp; ciabatta</h3>
          <p lang="vi">Thịt cổ lợn muối, quả nam việt quất và phô mai Brie</p>
        </article>
        <article>
          <h3>Paleta Iberico, avocado, cream cheese &amp; ciabatta</h3>
          <p lang="vi">Thịt lợn chân đen Tây Ban Nha muối, quả bơ, kem phô mai và bánh mì ciabatta</p>
        </article>
        <article>
          <h3>Wagyu beef tartare, flying fish roe, toast</h3>
          <p lang="vi">Thịt bò Wagyu sống trộn 3 loại xốt, trứng cá chuồn, bánh mỳ bơ áp chảo</p>
        </article>
        <article>
          <h3>Unagi, truffle oil, foie gras ballotine &amp; Vietnamese “bánh đa”</h3>
          <p lang="vi">Lươn nướng, dầu nấm Truffle, gan ngỗng muối và bánh đa</p>
        </article>
        <article>
          <h3>Grilled mushroom, truffle oil, aioli sauce, perilla leaf &amp; garlic cracker</h3>
          <p lang="vi">Nấm nướng, dầu nấm truffle, xốt aioli, lá tía tô và bánh mì tỏi giòn</p>
        </article>
      </div>
    </section>

    <!-- Couple Set -->
    <section class="set-card couple-card">
      <header>
        <p>“Two Much Fun”</p>
        <h2>A curated journey</h2>
        <strong>Couple Set Menu for 2 · 1,880K</strong>
      </header>
      <div class="journey">
        <section>
          <h2>The First Move</h2>
          <div class="set-items">
            <article>
              <h3>Bread &amp; butter</h3>
              <p lang="vi">Bánh mì và bơ</p>
            </article>
            <article>
              <h3>Japanese oyster &amp; lemon sorbet</h3>
              <p lang="vi">Hàu Nhật và kem chanh vàng</p>
            </article>
            <article>
              <h3>Stracciatella, seasonal fruits, poached pear, rice wine, honey &amp; candied peanut</h3>
              <p lang="vi">Salad nhân phô mai burrata, hoa quả theo mùa, lê hầm, nếp cẩm, mật ong và đậu phộng ngào đường</p>
            </article>
            <article>
              <h3>Foie gras, roasted apple, grilled pineapple &amp; mango salsa</h3>
              <p lang="vi">Gan ngỗng áp chảo với táo nướng, dứa nướng, xoài tươi trộn và bánh mì ngọt</p>
            </article>
          </div>
        </section>

        <section>
          <h2>Flirting Over Tapas</h2>
          <div class="set-items">
            <article>
              <h3>Raw shrimp in rice cracker</h3>
              <p lang="vi">Tôm sống cuộn trong bánh tráng giòn</p>
            </article>
            <article>
              <h3>Unagi, truffle oil, foie gras ballotine &amp; Vietnamese “bánh đa”</h3>
              <p lang="vi">Lươn nướng, dầu nấm truffle, gan ngỗng muối và bánh đa</p>
            </article>
          </div>
        </section>

        <section>
          <h2>Heated Moments</h2>
          <div class="set-items">
            <article>
              <h3>Japanese rice in shrimp bisque sauce, raw shrimp &amp; chili oil</h3>
              <p lang="vi">Cơm Nhật nấu trong xốt đầu tôm, tôm sống và dầu ớt</p>
            </article>
            <article>
              <h3>Wagyu flank (140gr), wedge potatoes, grilled king mushroom, truffle aioli &amp; black garlic purée</h3>
              <p lang="vi">Thịt bò Wagyu (140gr), khoai chiên ba lửa, nấm đùi gà, xốt tỏi truffle và tỏi đen nghiền</p>
            </article>
          </div>
        </section>

        <section>
          <h2>Lingering Sweetness</h2>
          <div class="set-items">
            <article>
              <h3>Basque burnt cheesecake truffle</h3>
              <p lang="vi">Bánh phô mai cháy nấm Truffle</p>
            </article>
            <article>
              <h3>Crème brûlée &amp; lotus seed</h3>
              <p lang="vi">Kem nướng đường vị hạt sen</p>
            </article>
          </div>
        </section>
      </div>
    </section>

    <!-- Brunch Footer -->
    <footer class="brunch-footer">
      <p>*** Reservation recommended! (Vui lòng bàn đặt trước).</p>
      <p>*** Ingredients are subject to seasonal availability. (Nguyên liệu có thể thay đổi theo mùa).</p>
      <p>*** Price in .000 VND, excluded VAT (Giá tính theo VND, chưa bao gồm VAT).</p>
      <p>*** Set menus do not apply with other promotions, vouchers or discounts.</p>
      <p>*** There is no service charge, so tips are welcome.</p>
    </footer>
  </div>

  <!-- PDF Download Section -->
  <section class="section section--alt" style="margin-top: 3rem;">
    <div class="container">
      <SectionHeader title="Thực Đơn PDF Gốc" />
      <p style="text-align: center; margin-bottom: 3rem; color: #666; font-size: 1.1rem;">Xem và tải xuống các menu thiết kế gốc của Pincho.</p>

      <div class="pdf-grid animate animate--up">
        <a href="https://drive.google.com/file/d/1uk5P_TjczPHcKSvlutTfdwYBe71PIk7c/view?usp=drive_link" target="_blank" rel="noopener noreferrer" class="pdf-card">
          <div class="pdf-card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
          </div>
