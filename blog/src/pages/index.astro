---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import MenuItem from '../components/MenuItem.astro';
import BlogCard from '../components/BlogCard.astro';
import ReservationForm from '../components/ReservationForm.astro';

import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 6);

const featuredMenu = [
  { name: 'Patatas Bravas', price: '95,000₫', description: 'Khoai tây giòn, sốt aioli xông khói & sốt cà chua cay' },
  { name: 'Wagyu Beef Tartare', price: '245,000₫', description: 'Thịt bò Wagyu xắt tay, trứng cút, dầu nấm phomai & bánh mì nướng' },
  { name: 'Grilled Iberico Pork', price: '385,000₫', description: 'Heo đen Tây Ban Nha nướng, sốt chimichurri & rau củ bỏ lò' },
  { name: 'Burrata Salad', price: '185,000₫', description: 'Phomai Burrata béo ngậy, cà chua mầm & sốt pesto húng tây' },
  { name: 'Raclette Cheese Platter', price: '295,000₫', description: 'Phomai Raclette nóng chảy phủ lên thịt nguội & khoai tây' },
  { name: 'Seafood Paella', price: '325,000₫', description: 'Cơm hải sản Tây Ban Nha, tôm, vẹm xanh, mực & xúc xích chorizo' },
];
---

<BaseLayout lang="vi" title="Pincho — Tapas Kitchen & Drinks | Nhà Hàng Tây Ban Nha Hà Nội">
  <!-- Hero Section -->
  <section class="hero" style="background-image: url('/images/posts/1185517790436446.jpg')">
    <div class="hero__content">
      <h1 class="hero__title animate animate--up">
        Tapas Kitchen <span>& Drinks</span>
      </h1>
      <p class="hero__subtitle animate animate--up">
        Nhà hàng tapas kết hợp ẩm thực Tây Ban Nha độc đáo, cocktail sáng tạo và không gian lãng mạn tại tầng cao biệt thự Pháp cổ 34C Cao Bá Quát, Hà Nội.
      </p>
      <div class="animate animate--up" style="margin: 1.5rem 0 2rem; display: flex; justify-content: center; gap: 1rem; align-items: center;">
        <span style="background: rgba(230, 81, 0, 0.9); padding: 8px 16px; border-radius: 50px; font-size: 0.75rem; font-weight: 700; color: #fff; letter-spacing: 0.05em; text-transform: uppercase; border: 1px solid rgba(255,255,255,0.2);">
          <i class="fas fa-crown"></i> Restaurant of the Year 2022
        </span>
      </div>
      <div class="animate animate--up" style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/book-a-table/" class="btn btn--primary" style="padding: 14px 36px; border-radius: 50px;">
          <i class="far fa-calendar-alt" style="margin-right: 8px;"></i> Đặt Bàn Ngay
        </a>
        <a href="/menu/" class="hero__cta">Khám Phá Thực Đơn</a>
      </div>
    </div>
  </section>

  <!-- About Preview -->
  <section class="section section--alt">
    <div class="container about-preview">
      <SectionHeader title="Chào mừng đến" accent="Pincho" />
      <p class="about-preview__text animate animate--up">
        Ẩn mình trên các tầng cao của ngôi biệt thự Pháp cổ quyến rũ tại 34C Cao Bá Quát, Pincho mang đến trải nghiệm ẩm thực tapas chuẩn vị và đẳng cấp. Ánh đèn ấm áp cùng thiết kế ấn tượng tạo nên không gian hoàn hảo cho những buổi hẹn hò lãng mạn hay buổi tụ họp ấm cúng, kết hợp sáng tạo giữa hương vị phong phú của Tây Ban Nha, nguyên liệu chọn lọc và nghệ thuật ẩm thực tinh tế.
      </p>
      <a href="/about/" class="btn btn--outline btn--center animate animate--up">Đọc Câu Chuyện Của Chúng Tôi →</a>
    </div>
  </section>

  <!-- Featured Menu -->
  <section class="section">
    <div class="container">
      <SectionHeader title="Món Ăn" accent="Nổi Bật" subtitle="Khám phá các món tapas đặc trưng kết hợp hoàn hảo cùng rượu vang Tây Ban Nha và cocktail sáng tạo" />
      <div class="menu-grid animate animate--up">
        {featuredMenu.map(item => (
          <MenuItem name={item.name} price={item.price} description={item.description} />
        ))}
      </div>
      <a href="/menu/" class="btn btn--primary btn--center">Xem Toàn Bộ Thực Đơn</a>
    </div>
  </section>

  <!-- Reservation Section on Homepage -->
  <section class="section section--alt" id="reservation-section">
    <div class="container">
      <SectionHeader
        title="Đặt Bàn"
        accent="Trực Tuyến"
        subtitle="Giữ chỗ trước để có trải nghiệm vị trí bàn đẹp nhất tại Pincho"
      />
      <div style="max-width: 800px; margin: 0 auto;" class="animate animate--up">
        <ReservationForm lang="vi" googleFormId="e/1FAIpQLSclTlFq-nZN3xKaWHlde1dTNANKSEan-QeQJCzhOIGjthW_zA" />
      </div>
    </div>
  </section>

  <!-- Blog Checkerboard -->
  <section class="section">
    <div class="container">
      <SectionHeader title="Bài Viết &" accent="Câu Chuyện" subtitle="Góc chia sẻ từ bếp ăn và không gian Pincho" />
    </div>
    <div class="blog-checkerboard">
      {posts.map(post => (
        <BlogCard
          title={post.data.title}
          date={post.data.date}
          excerpt={post.data.description}
          image={post.data.images?.[0]}
          href={`/posts/${post.id}/`}
        />
      ))}
    </div>
    <a href="/posts/" class="btn btn--primary btn--center" style="margin-top: 2rem;">Xem Tất Cả Bài Viết</a>
  </section>

  <!-- Contact Strip -->
  <section class="section" style="padding: 0;">
    <div class="container">
      <div class="contact-strip">
        <div class="contact-strip__item">
          <div class="contact-strip__label">Địa chỉ</div>
          <div class="contact-strip__value">34C Cao Bá Quát, Ba Đình, Hà Nội</div>
        </div>
        <div class="contact-strip__item">
          <div class="contact-strip__label">Đặt bàn</div>
          <div class="contact-strip__value"><a href="tel:0949022882">0949.022.882</a></div>
        </div>
        <div class="contact-strip__item">
          <div class="contact-strip__label">Giờ mở cửa</div>
          <div class="contact-strip__value">Thứ 2 – Chủ Nhật: 11:00 – 23:00</div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
